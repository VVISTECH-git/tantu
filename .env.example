GEMINI_API_KEY=your-key-here
# Protects the hosted page so strangers can't spend your credits.
ACCESS_PASSWORD=choose-a-password
# Comma-separated model IDs. Check https://ai.google.dev/gemini-api/docs/models for current names.
MODELS=gemini-3.1-flash-image-preview,gemini-3.1-flash-lite-image-preview
POSES=front,three-quarter,back
MODEL_SKIN_TONE=medium-wheatish
MODEL_REGION=South Indian
# Cost estimate inputs (USD per 1M tokens). Update from Google's pricing page.
PRICE_IN_PER_M=0.30
PRICE_OUT_PER_M=30
USD_INR=85
